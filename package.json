{
  "name": "share-it",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter=api dev & bun run --filter=web dev",
    "build": "bun run build:web",
    "build:api": "cd apps/api && bun run build",
    "build:web": "cd apps/web && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "wrangler": "^3.107.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "share-it": "."
  }
}
