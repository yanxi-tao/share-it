{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "bun build --target=node --alias=\"@libsql/client=@libsql/client/http\" --outdir=dist src/server.ts",
    "start": "NODE_ENV=production bun run dist/server.js",
    "db:push": "bun run --bun drizzle-kit push",
    "db:studio": "bun run --bun drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@libsql/client": "^0.14.0",
    "better-auth": "^1.1.16",
    "drizzle-orm": "^0.39.2",
    "hono": "^4.6.20",
    "nanoid": "^5.1.0",
    "unfurl.js": "^6.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
"drizzle-kit": "^0.30.4"
  }
}
