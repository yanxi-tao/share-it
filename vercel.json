{
  "buildCommand": "bun run build",
  "installCommand": "bun install --frozen-lockfile",
  "framework": "vite",
  "bunVersion": "1.x",
  "builds": [
    { "src": "apps/web/package.json", "use": "@vercel/static" },
    { "src": "apps/api/package.json", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/api/$1" },
    { "src": "/(.*)", "dest": "apps/web/$1" }
  ]
}